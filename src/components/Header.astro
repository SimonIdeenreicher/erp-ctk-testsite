---
const BOOKING_URL =
  'https://bookings.cloud.microsoft/book/TerminbuchungBeratungsgesprch@ctk-gmbh.de/?ismsaljsauthenabled=true';

const navLinks = [
  { label: 'Herausforderungen', href: '#herausforderungen' },
  { label: 'Vorteile', href: '#vorteile' },
  { label: 'Vorgehen', href: '#vorgehen' },
  { label: 'mesonic WinLine', href: '#winline' },
  { label: 'Warum CTK', href: '#warum-ctk' },
  { label: 'Referenzen', href: '#referenzen' },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur relative">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-3 lg:px-8">
    <a
      href="https://www.ctk-gmbh.de"
      class="flex shrink-0 items-center gap-3"
      aria-label="CTK IT-Lösungen und Service Home"
    >
      <img
        src="/assets/header/ctk-logo.svg"
        alt="CTK IT-Lösungen und Service"
        width="113"
        height="43"
        class="h-[43px] w-[113px]"
      />
    </a>

    <nav class="hidden items-center gap-6 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-muted transition-colors hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-lg bg-gradient-to-br from-brand to-brand-dark px-4 py-2 text-[14.4px] font-semibold text-white shadow-[0px_4px_14px_0px_rgba(59,130,246,0.35)] transition-opacity hover:opacity-90 sm:inline-block"
      >
        Termin vereinbaren
      </a>
      <button
        id="menu-toggle"
        type="button"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border bg-surface text-muted transition-colors hover:text-foreground lg:hidden"
      >
        <svg id="icon-burger" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="absolute left-0 right-0 top-full hidden flex-col gap-1 border-t border-border bg-background px-6 py-4 shadow-lg lg:hidden"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-lg px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface hover:text-foreground"
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={BOOKING_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-2 rounded-lg bg-gradient-to-br from-brand to-brand-dark px-4 py-2 text-center text-[14.4px] font-semibold text-white shadow-[0px_4px_14px_0px_rgba(59,130,246,0.35)] transition-opacity hover:opacity-90"
    >
      Termin vereinbaren
    </a>
  </nav>
</header>

<script is:inline>
  (function () {
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconBurger = document.getElementById('icon-burger');
    const iconClose = document.getElementById('icon-close');

    function setOpen(isOpen) {
      mobileMenu.classList.toggle('hidden', !isOpen);
      mobileMenu.classList.toggle('flex', isOpen);
      iconBurger.classList.toggle('hidden', isOpen);
      iconClose.classList.toggle('hidden', !isOpen);
      menuToggle.setAttribute('aria-expanded', String(isOpen));
      menuToggle.setAttribute('aria-label', isOpen ? 'Menü schließen' : 'Menü öffnen');
    }

    menuToggle.addEventListener('click', () => {
      setOpen(mobileMenu.classList.contains('hidden'));
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  })();
</script>
