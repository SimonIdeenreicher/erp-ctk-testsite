---
const FORMINIT_FORM_ID = 'l3y675bax1j';

const fields = [
  { id: 'name', name: 'fi-text-name', label: 'Ihr Name', type: 'text', placeholder: 'z. B. Max Mustermann', required: true },
  { id: 'company', name: 'fi-sender-company', label: 'Unternehmen', type: 'text', placeholder: 'z. B. Musterfirma GmbH', required: true },
];
---

<section id="kontakt" class="bg-surface py-24" data-reveal>
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 lg:grid-cols-[1.4fr_1fr] lg:px-8">
    <div class="rounded-2xl bg-background p-8 shadow-sm">
      <p class="flex items-center gap-2 text-xs font-bold tracking-wide text-brand uppercase">
        <span class="h-3.5 w-1 rounded-full bg-brand"></span>
        Kontakt
      </p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
        Lassen Sie uns über Ihre Prozesse sprechen
      </h2>
      <p class="mt-3 max-w-md text-sm text-muted">
        Ob ERP-Wechsel, Digitalisierung oder individuelle Anforderungen – wir unterstützen Sie gerne bei der
        Bewertung Ihrer Möglichkeiten.
      </p>

      <form id="contact-form" class="mt-8 space-y-5">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          {
            fields.map((f) => (
              <div>
                <label for={f.id} class="text-sm font-medium text-foreground">
                  {f.label} {f.required && <span class="text-danger">*</span>}
                </label>
                <input
                  id={f.id}
                  name={f.name}
                  type={f.type}
                  placeholder={f.placeholder}
                  required={f.required}
                  class="mt-1.5 w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none"
                />
              </div>
            ))
          }
        </div>

        <div>
          <label for="email" class="text-sm font-medium text-foreground">
            E-Mail-Adresse <span class="text-danger">*</span>
          </label>
          <input
            id="email"
            name="fi-sender-email"
            type="email"
            placeholder="name@firma.de"
            required
            class="mt-1.5 w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none"
          />
        </div>

        <div>
          <label for="message" class="text-sm font-medium text-foreground">Ihre Nachricht / Anforderungen</label>
          <textarea
            id="message"
            name="fi-text-message"
            rows="4"
            placeholder="Beschreiben Sie kurz Ihre aktuellen Herausforderungen oder Wünsche…"
            class="mt-1.5 w-full resize-none rounded-lg border border-border bg-background px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none"
          ></textarea>
        </div>

        <button
          id="contact-form-submit"
          type="submit"
          class="w-full rounded-lg bg-brand-dark px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
        >
          Jetzt unverbindliches Beratungsgespräch vereinbaren
        </button>

        <p id="contact-form-status" class="text-center text-sm" role="status" aria-live="polite"></p>
      </form>
    </div>

    <div
      class="rounded-2xl p-8 text-center"
      style="background-image: linear-gradient(135deg, var(--brand) 0%, #00497f 100%);"
    >
      <div class="mx-auto flex h-[102px] w-[102px] items-center justify-center overflow-hidden rounded-full border-[3px] border-[#f0f9ff]">
        <img
          src="/assets/contact/david-werner.jpg"
          alt="David Werner"
          width="102"
          height="102"
          class="h-full w-full object-cover"
        />
      </div>
      <p class="mt-4 font-bold text-white">David Werner</p>
      <p class="text-sm text-white/60">Vertrieb Business Software</p>

      <div class="mt-6 space-y-3 text-center text-sm">
        <a href="mailto:david.werner@ctk-gmbh.de" class="flex items-center justify-center gap-2.5 text-white/80 hover:text-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0 text-accent">
            <path d="M3 6h18v12H3zM3 6l9 7 9-7" />
          </svg>
          david.werner@ctk-gmbh.de
        </a>
        <a href="tel:+4984636423-0" class="flex items-center justify-center gap-2.5 text-white/80 hover:text-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0 text-accent">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.7a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2Z" />
          </svg>
          +49 (8463) 64 23-0
        </a>
        <div class="flex items-start justify-center gap-2.5 text-white/80">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 shrink-0 text-accent">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span>CTK GmbH, An der Gredl 3,<br />91171 Greding, Deutschland</span>
        </div>
      </div>

      <span class="mt-6 inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-brand-dark">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-accent">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 6v6l4 2" />
        </svg>
        Antwort innerhalb von 24h
      </span>
    </div>
  </div>
</section>

<script define:vars={{ FORMINIT_FORM_ID }} is:inline>
  (async function () {
    // Astro bundles a plain <script src="https://..."> as a deferred module import, which would
    // run after this classic script — load it ourselves so `Forminit` is guaranteed ready in time.
    await import('https://forminit.com/sdk/v1/forminit.js');

    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('contact-form-submit');
    const statusEl = document.getElementById('contact-form-status');
    const defaultLabel = submitBtn.textContent;
    const forminitClient = new Forminit();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Wird gesendet…';
      statusEl.textContent = '';
      statusEl.classList.remove('text-accent', 'text-danger');

      try {
        const formData = new FormData(form);
        const { error } = await forminitClient.submit(FORMINIT_FORM_ID, formData);
        if (error) throw new Error(error.message || 'Unbekannter Fehler');

        form.reset();
        statusEl.textContent = 'Danke! Ihre Nachricht wurde erfolgreich gesendet.';
        statusEl.classList.add('text-accent');
      } catch (err) {
        statusEl.textContent =
          'Da ist leider etwas schiefgelaufen. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt per E-Mail.';
        statusEl.classList.add('text-danger');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = defaultLabel;
      }
    });
  })();
</script>
