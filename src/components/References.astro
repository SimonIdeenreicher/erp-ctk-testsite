<section id="referenzen" class="bg-background py-24" data-reveal>
  <div class="mx-auto max-w-5xl px-6 text-center lg:px-8">
    <p class="flex items-center justify-center gap-2 text-xs font-bold tracking-wide text-brand-dark uppercase">
      <span class="h-3.5 w-1 rounded-full bg-brand"></span>
      Kundenstimmen & Erfolge
    </p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
      Unternehmen, die auf CTK vertrauen
    </h2>
  </div>

  <div class="mx-auto mt-12 flex max-w-4xl flex-col gap-6 px-6 lg:px-8">
    <div class="flex justify-start gap-2 overflow-x-auto border-b border-border [-ms-overflow-style:none] [scrollbar-width:none] sm:justify-center [&::-webkit-scrollbar]:hidden">
      {
        tabs.map((tab, i) => (
          <label
            for={`tab-${tab.id}`}
            class="group relative -mb-px flex shrink-0 cursor-pointer items-center gap-2 border-b-2 border-transparent px-6 py-4 text-sm font-semibold whitespace-nowrap text-muted has-checked:border-[#73aed4] has-checked:text-brand-dark"
          >
            <input type="radio" name="reference-tab" id={`tab-${tab.id}`} class="peer sr-only" checked={i === 0} />
            <span class="-scale-y-100 inline-block h-4 w-4">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox={tab.icon.viewBox} fill="currentColor" class="h-4 w-4">
                <path d={tab.icon.d} />
              </svg>
            </span>
            {tab.label}
          </label>
        ))
      }
    </div>

    {
      tabs.map((tab) => (
        <div
          class="rounded-xl border border-[#f0f0f0] bg-[#f0f0f0] p-10 shadow-[0px_8px_30px_0px_rgba(148,163,184,0.06),0px_1px_3px_0px_rgba(0,0,0,0.02)]"
          data-panel={tab.id}
        >
          {tab.content ? (
            <div class="grid grid-cols-1 gap-8 text-left lg:grid-cols-[1fr_auto]">
              <div>
                <p class="text-lg leading-relaxed font-medium text-foreground italic">"{tab.content.quote}"</p>
                <p class="mt-5 font-semibold text-foreground">{tab.content.project}</p>
                <p class="text-sm text-muted">{tab.content.company}</p>
              </div>
              <div class="flex flex-col gap-4">
                {tab.content.stats.map((s) => (
                  <div class="min-w-[180px] rounded-lg border border-[#c5dd84] bg-accent-soft px-6 py-5 text-center">
                    <p class="text-2xl font-extrabold text-accent">{s.value}</p>
                    <p class="mt-1 text-xs font-semibold text-muted">{s.label}</p>
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <p class="py-10 text-center text-sm text-muted">Referenz-Inhalt folgt in Kürze.</p>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Show only the panel whose radio tab is checked */
  [data-panel] {
    display: none;
  }
</style>

<script is:inline>
  (function () {
    const tabs = document.querySelectorAll('input[name="reference-tab"]');
    const panels = document.querySelectorAll('[data-panel]');
    function sync() {
      const checked = document.querySelector('input[name="reference-tab"]:checked');
      const id = checked ? checked.id.replace('tab-', '') : null;
      panels.forEach((p) => {
        p.style.display = p.dataset.panel === id ? 'block' : 'none';
      });
    }
    tabs.forEach((t) => t.addEventListener('change', sync));
    sync();
  })();
</script>
