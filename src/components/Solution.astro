---
const benefits = [
  {
    title: 'Individuelle Beratung statt Standard',
    body: 'Wir richten uns nach Ihren Abläufen, nicht nach Schema F.',
  },
  {
    title: 'Prozess- und Digitalisierungskompetenz',
    body: 'Tiefes Verständnis für moderne, digitale Geschäftsmodelle.',
  },
  {
    title: 'IT, Software & Entwicklung aus einer Hand',
    body: 'Keine Schnittstellenprobleme oder Zuständigkeits-Debatten.',
  },
  {
    title: 'Persönliche Betreuung',
    body: 'Ein fester Ansprechpartner von der Analyse über den Go-Live hinaus.',
  },
];
---

<section id="vorteile" class="bg-background py-24">
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-12 px-6 lg:grid-cols-2 lg:px-8">
    <div>
      <div class="relative aspect-[544/308] w-full overflow-hidden rounded-2xl bg-gradient-to-br from-brand to-brand-dark">
        <img
          src="/assets/solution/team-photo.png"
          alt="Das CTK-Team in Firmen-Poloshirts"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>

      <p class="mt-8 flex items-center gap-2 text-sm font-semibold tracking-[1.4px] text-brand-dark uppercase">
        <span class="h-3.5 w-1 rounded-full bg-brand"></span>
        Lösungsansatz & Philosophie
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-[44px] lg:leading-[52.8px] lg:tracking-[-0.88px]">
        ERP mit Verständnis für Ihr Business
      </h2>
      <p class="mt-4 max-w-lg text-lg leading-[28.8px] text-muted">
        Unser Ziel ist es, eine ERP-Lösung zu schaffen, die Ihre Abläufe vereinfacht, Prozesse automatisiert und Ihr
        Unternehmen langfristig unterstützt.
      </p>
    </div>

    <div class="rounded-xl border border-[#c5dd84] bg-accent-soft p-10 shadow-[0px_8px_30px_0px_rgba(148,163,184,0.06),0px_1px_3px_0px_rgba(0,0,0,0.02)]">
      <h3 class="text-2xl font-bold tracking-[-0.48px] text-foreground">Ihre Vorteile mit CTK</h3>
      <ul class="mt-7 flex flex-col gap-7">
        {
          benefits.map((b) => (
            <li class="flex gap-5">
              <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-accent text-white">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              <div>
                <p class="font-semibold text-foreground">{b.title}</p>
                <p class="mt-0.5 text-[14.8px] leading-[23.68px] text-muted">{b.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
