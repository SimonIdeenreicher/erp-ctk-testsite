---
const columns = [
  {
    title: 'Navigation',
    links: [
      { label: 'Herausforderungen', href: '#herausforderungen' },
      { label: 'Vorteile', href: '#vorteile' },
      { label: 'Unser Vorgehen', href: '#vorgehen' },
      { label: 'mesonic WinLine', href: '#winline' },
    ],
  },
  {
    title: 'Über CTK',
    links: [
      { label: 'Warum CTK', href: '#warum-ctk' },
      { label: 'Referenzen', href: '#referenzen' },
      { label: 'Beratung vereinbaren', href: '#kontakt' },
    ],
  },
  {
    title: 'Rechtliches',
    links: [
      { label: 'Impressum', href: 'https://www.ctk-gmbh.de/impressum' },
      { label: 'Datenschutz', href: 'https://www.ctk-gmbh.de/datenschutz' },
      { label: 'Cookie-Einstellungen', href: '#', id: 'footer-cookie-settings' },
    ],
  },
];
---

<footer
  class="relative overflow-hidden pt-16 pb-8"
  style="background-image: linear-gradient(139.02deg, #006cb5 0%, #00497f 99.994%);"
  data-reveal
>
  <!-- Dots-pattern (real Figma vector asset, node 1846:1319/1846:1320) -->
  <div
    class="pointer-events-none absolute left-0 right-0 overflow-hidden"
    style="top: calc(-19.18% - 1.19px); bottom: calc(-119.15% - 1.19px);"
    aria-hidden="true"
  >
    <div
      class="absolute opacity-[0.14]"
      style="
        left: -202.24px;
        top: -588.75px;
        width: 2576.714px;
        height: 1721.848px;
        mask-image: url('/assets/footer/footer-dots-mask.svg');
        mask-repeat: no-repeat;
        mask-position: 202.235px 588.753px;
        mask-size: 1920px 959.722px;
        -webkit-mask-image: url('/assets/footer/footer-dots-mask.svg');
        -webkit-mask-repeat: no-repeat;
        -webkit-mask-position: 202.235px 588.753px;
        -webkit-mask-size: 1920px 959.722px;
      "
    >
      <img
        src="/assets/footer/footer-dots-pattern.svg"
        alt=""
        class="absolute inset-0 block h-full w-full max-w-none"
      />
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-12">
      <div class="max-w-xs">
        <img src="/assets/footer/ctk-logo-white.svg" alt="CTK GmbH" class="h-14 w-auto" />
        <p class="mt-3 text-[17.6px] font-extrabold tracking-[0.88px] text-white uppercase">
          Business Software
        </p>
        <p class="mt-4 text-[14.4px] leading-[23px] text-white/70">
          Wir begleiten mittelständische Unternehmen bei der Digitalisierung ihrer Geschäftsprozesse.
        </p>
      </div>

      {
        columns.map((col) => (
          <div>
            <h3 class="text-[15.2px] font-semibold tracking-[-0.3px] text-white">{col.title}</h3>
            <ul class="mt-4 space-y-3">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    id={link.id}
                    class="text-[14.4px] leading-[21.6px] text-white/75 transition-colors hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 border-t border-[#f0f9ff] pt-8 text-center text-[12.8px] leading-[20.48px] text-[#f8fafc]">
      © {new Date().getFullYear()} CTK GmbH. Alle Rechte vorbehalten. mesonic WinLine ist ein eingetragenes
      Warenzeichen der mesonic GmbH.
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    const link = document.getElementById('footer-cookie-settings');
    link?.addEventListener('click', (e) => {
      e.preventDefault();
      window.ctkOpenCookieSettings?.();
    });
  })();
</script>
